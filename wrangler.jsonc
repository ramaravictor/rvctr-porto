// Cloudflare Workers deploy for the static export in out/ (see next.config.ts).
// `npm run build` creates out/, then `npx wrangler deploy` uploads it as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "connect",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./out",
    // /work/undang-in serves out/work/undang-in.html; unknown paths get out/404.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
